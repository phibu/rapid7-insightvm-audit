# Normalize line endings. The repo is developed on Windows but CI runs on
# Linux and releases are built with `git archive` -- committing everything as
# LF keeps the working tree, CI, and the runtime zip byte-stable regardless
# of each developer's core.autocrlf setting.

# Default: treat every file as text and store it with LF in the repo.
* text=eol=lf

# Source and config -- explicit for clarity (covered by the default above).
*.py    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.toml  text eol=lf
*.j2    text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.txt   text eol=lf

# Dotfiles without extensions.
.gitignore     text eol=lf
.gitattributes text eol=lf
.env.example   text eol=lf

# Binary files: never normalize, never diff as text. None exist today --
# listed so a future addition is handled correctly without churn.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.gz    binary
*.pdf   binary
*.woff  binary
*.woff2 binary

# Keep generated/vendored artifacts out of `git diff` and language stats.
docs/research/api-v3.json linguist-generated=true
docs/research/api-v4.json linguist-generated=true
