<!doctype html>
<html lang="en" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<script>
(function(){
  document.documentElement.classList.remove('no-js');
  try {
    var t = localStorage.getItem('theme');
    if (t === 'light' || t === 'dark') {
      document.documentElement.setAttribute('data-theme', t);
    }
  } catch(e) {}
})();
</script>
<style>
  :root {
    --font-sans: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    --font-mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;

    --neutral-fg: #1a1a1a;
    --neutral-muted: #5a5a5a;
    --border: #e3e3e3;
    --surface: #fafafa;
    --bg: #ffffff;

    --pass-fg: #0f6b3a;
    --pass-bg: #e6f5ec;
    --warn-fg: #8a4b00;
    --warn-bg: #fdf2dc;
    --fail-fg: #9a2417;
    --fail-bg: #fbe7e3;
    --info-fg: #1f4e8c;
    --info-bg: #e6eef9;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --neutral-fg: #e8e8ea;
      --neutral-muted: #9a9aa3;
      --border: #2a2e38;
      --surface: #161922;
      --bg: #0f1115;
      --pass-fg: #4dbe7a;
      --pass-bg: rgba(77,190,122,0.12);
      --warn-fg: #e0a04b;
      --warn-bg: rgba(224,160,75,0.14);
      --fail-fg: #e6786b;
      --fail-bg: rgba(230,120,107,0.14);
      --info-fg: #6aa6ee;
      --info-bg: rgba(106,166,238,0.14);
    }
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { background: var(--bg); }
  body {
    font-family: var(--font-sans);
    color: var(--neutral-fg);
    background: var(--bg);
    margin: 2rem auto;
    max-width: 1100px;
    padding: 0 1.5rem;
    font-size: 15px;
    line-height: 1.55;
  }
  code, pre, .mono { font-family: var(--font-mono); font-size: 0.92em; }
  table { font-variant-numeric: tabular-nums; }

  h1 { margin: 0 0 0.25rem 0; font-size: 28px; letter-spacing: -0.01em; }
  h2 { margin: 2rem 0 0.5rem 0; font-size: 22px; }
  h3 { margin: 1rem 0 0.5rem 0; font-size: 18px; }

  a { color: var(--info-fg); text-underline-offset: 2px; }
  a:focus-visible, button:focus-visible, summary:focus-visible {
    outline: 2px solid var(--info-fg);
    outline-offset: 2px;
  }

  .meta {
    color: var(--neutral-muted);
    font-size: 13px;
    margin: 0 0 1.5rem 0;
    display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem;
  }
  .meta b { color: var(--neutral-fg); font-weight: 600; }

  .hero {
    margin: 1rem 0 1rem;
    padding: 1.25rem 1.5rem;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    border: 1px solid var(--border);
  }
  .hero.pass { background: var(--pass-bg); }
  .hero.warn { background: var(--warn-bg); }
  .hero.fail { background: var(--fail-bg); }
  .hero .verdict-word {
    font-size: 36px; font-weight: 700; letter-spacing: -0.02em;
    color: var(--neutral-fg);
  }
  .hero.pass .verdict-word { color: var(--pass-fg); }
  .hero.warn .verdict-word { color: var(--warn-fg); }
  .hero.fail .verdict-word { color: var(--fail-fg); }
  .hero .verdict-summary {
    font-size: 15px; color: var(--neutral-muted); text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .delta-strip {
    margin: 0 0 1.5rem 0;
    padding: 0.5rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem;
    font-size: 13px;
    color: var(--neutral-muted);
  }
  .delta-pill {
    padding: 0.15rem 0.6rem; border-radius: 999px; font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .delta-pill.dp-down { background: var(--pass-bg); color: var(--pass-fg); }
  .delta-pill.dp-up   { background: var(--fail-bg); color: var(--fail-fg); }
  .delta-pill.dp-mid  { background: var(--warn-bg); color: var(--warn-fg); }
  .delta-strip .since { margin-left: auto; }

  .inventory-totals {
    margin: 0 0 1.5rem 0;
    padding: 0.75rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .inventory-totals h2 {
    margin: 0 0 0.5rem 0;
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--neutral-muted);
    font-weight: 600;
  }
  .totals-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-variant-numeric: tabular-nums;
  }
  .total-tile {
    display: flex;
    flex-direction: column;
    padding: 0.25rem 0;
    min-width: 120px;
  }
  .total-label {
    font-size: 12px;
    color: var(--neutral-muted);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  .total-value {
    font-size: 22px;
    font-weight: 600;
    color: var(--neutral-fg);
    line-height: 1.2;
  }

  .metric-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 0.75rem;
    margin: 0 0 2rem 0;
  }
  .metric {
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    background: var(--surface);
  }
  .metric-label {
    font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em;
    color: var(--neutral-muted); margin: 0 0 0.25rem 0;
  }
  .metric-value {
    font-size: 28px; font-weight: 600; line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  .metric-sub { font-size: 13px; color: var(--neutral-muted); margin-top: 0.25rem; }

  table { width: 100%; border-collapse: collapse; margin: 0.5rem 0 1.5rem; }
  th, td {
    text-align: left; padding: 0.55rem 0.7rem;
    border-bottom: 1px solid var(--border); vertical-align: top;
  }
  tbody tr:nth-child(even) { background: var(--surface); }

  .badge {
    display: inline-block; padding: 0.15rem 0.55rem; border-radius: 4px;
    font-size: 12px; font-weight: 600;
  }
  .badge.pass    { background: var(--pass-bg); color: var(--pass-fg); }
  .badge.warn    { background: var(--warn-bg); color: var(--warn-fg); }
  .badge.fail,
  .badge.error   { background: var(--fail-bg); color: var(--fail-fg); }
  .badge.skipped { background: var(--info-bg); color: var(--info-fg); }
  .badge.info    { background: var(--info-bg); color: var(--info-fg); }

  section.check { margin: 2.5rem 0; scroll-margin-top: 90px; }
  section.check h2 { margin: 0 0 0.25rem 0; }
  .check-desc { color: var(--neutral-muted); margin: 0 0 0.75rem 0; }

  .tiles { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0.75rem 0 1rem; }
  .tile {
    background: var(--surface); border: 1px solid var(--border);
    padding: 0.4rem 0.7rem; border-radius: 6px; font-size: 13px;
    font-variant-numeric: tabular-nums;
  }
  .tile b { display: block; font-size: 16px; }

  .error-box {
    background: var(--fail-bg); color: var(--fail-fg);
    border: 1px solid var(--fail-fg);
    padding: 0.75rem 1rem; border-radius: 6px;
  }
  .skipped-box {
    background: var(--info-bg); color: var(--info-fg);
    border: 1px solid var(--border);
    padding: 0.75rem 1rem; border-radius: 6px;
  }

  details { margin: 0.5rem 0; }
  details summary {
    cursor: pointer; padding: 0.4rem 0; font-weight: 600;
  }
  /* Jump-target offset so the sticky filter bar doesn't cover anchored rules. */
  details[id^="rule-"] { scroll-margin-top: 80px; }
  .rule-duration {
    margin-left: auto;
    color: var(--neutral-muted);
    font-weight: 400;
    font-size: 12px;
    font-variant-numeric: tabular-nums;
  }
  details summary { display: flex; align-items: center; gap: 0.5rem; }
  details summary::-webkit-details-marker { display: none; }
  details summary::before {
    content: "▸"; color: var(--neutral-muted); font-size: 11px;
    transition: transform 150ms;
  }
  details[open] summary::before { content: "▾"; }
  /* Humanized rule summary box -- replaces the old code-format key=value list. */
  dl.rule-summary {
    display: flex; flex-wrap: wrap; gap: 0.4rem;
    margin: 0.5rem 0 0.75rem 0;
    padding: 0.6rem 0.75rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 13px;
  }
  dl.rule-summary .rs-item {
    display: inline-flex; align-items: baseline; gap: 0.35rem;
    padding-right: 0.75rem;
    border-right: 1px solid var(--border);
  }
  dl.rule-summary .rs-item:last-child { border-right: none; padding-right: 0; }
  dl.rule-summary dt {
    color: var(--neutral-muted); font-size: 12px;
    text-transform: uppercase; letter-spacing: 0.03em;
    margin: 0;
  }
  dl.rule-summary dd {
    margin: 0; font-weight: 600; color: var(--neutral-fg);
    font-variant-numeric: tabular-nums;
  }
  /* Standardized "N examined · N passed · N failed" header line, populated
     by rules that supply card_summary via make_rule_result(examined=, failed=).
     Rendered between the rule summary toggle and the description; falls back
     to the existing dl.rule-summary block when card_summary is None. */
  .rule-card-summary {
    display: flex; flex-wrap: wrap; align-items: baseline;
    gap: 0.4rem;
    margin: 0.25rem 0 0.5rem;
    font-size: 13px;
    color: var(--neutral-muted);
    font-variant-numeric: tabular-nums;
  }
  .rule-card-summary strong { color: var(--neutral-fg); font-weight: 600; }
  .rule-card-summary .card-summary-sep { color: var(--neutral-muted); }
  pre {
    background: var(--surface); padding: 0.5rem 0.75rem; border-radius: 4px;
    overflow-x: auto; font-size: 12px; max-height: 240px; overflow-y: auto;
    border: 1px solid var(--border);
  }

  footer {
    color: var(--neutral-muted); font-size: 13px; margin-top: 3rem;
    border-top: 1px solid var(--border); padding-top: 1rem;
  }
  footer code { color: var(--neutral-fg); }

  @media print {
    body { max-width: none; margin: 0; padding: 1cm; color: #000; background: #fff; }
    :root {
      --bg: #fff; --neutral-fg: #000; --neutral-muted: #444; --surface: #f6f6f6;
    }
    .delta-strip, .metric-grid, .inventory-totals { page-break-inside: avoid; }
    section.check { page-break-before: always; page-break-inside: auto; }
    section.check:first-of-type { page-break-before: avoid; }
    details { page-break-inside: avoid; }
    details[open] summary { page-break-after: avoid; }
    /* Force-expand all <details> for print -- paper readers can't click. */
    details { display: block; }
    details > summary { list-style: none; }
    details > *:not(summary) { display: block !important; }
    a[href]::after { content: " (" attr(href) ")"; font-size: 0.85em; color: #555; }
    a[href^="#"]::after { content: ""; }
    .filter-bar { display: none; }
    .theme-toggle { display: none; }
    .section-rail { display: none; }
    .report-grid { display: block; }
    .content-column { max-width: none; }
  }
  /* JS-disabled fallback: hide chrome that depends on JS to function. */
  .no-js .filter-bar,
  .no-js .theme-toggle { display: none; }
  /* Theme toggle -- three-state cycle (system / light / dark). */
  .theme-toggle {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.6rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--neutral-fg);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
    transition: background 150ms;
  }
  .theme-toggle:hover { background: var(--info-bg); }
  .theme-toggle .theme-icon { display: block; }
  /* Explicit overrides -- declared after the prefers-color-scheme media query
     so they win when a user has clicked the toggle to override system. */
  :root[data-theme="light"] {
    --neutral-fg: #1a1a1a; --neutral-muted: #5a5a5a;
    --border: #e3e3e3; --surface: #fafafa; --bg: #ffffff;
    --pass-fg: #0f6b3a; --pass-bg: #e6f5ec;
    --warn-fg: #8a4b00; --warn-bg: #fdf2dc;
    --fail-fg: #9a2417; --fail-bg: #fbe7e3;
    --info-fg: #1f4e8c; --info-bg: #e6eef9;
  }
  :root[data-theme="dark"] {
    --neutral-fg: #e8e8ea; --neutral-muted: #9a9aa3;
    --border: #2a2e38; --surface: #161922; --bg: #0f1115;
    --pass-fg: #4dbe7a; --pass-bg: rgba(77,190,122,0.12);
    --warn-fg: #e0a04b; --warn-bg: rgba(224,160,75,0.14);
    --fail-fg: #e6786b; --fail-bg: rgba(230,120,107,0.14);
    --info-fg: #6aa6ee; --info-bg: rgba(106,166,238,0.14);
  }
  /* Filter bar -- sticky from where it first appears in flow. */
  .filter-bar {
    position: sticky;
    top: 0;
    z-index: 10;
    margin: 1rem 0 1.5rem 0;
    padding: 0.6rem 0.75rem;
    background: var(--bg);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    align-items: center;
  }
  .filter-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .chip {
    padding: 0.25rem 0.65rem;
    background: var(--surface);
    color: var(--neutral-muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    font: inherit;
    font-size: 13px;
    cursor: pointer;
    transition: background 150ms, color 150ms, border-color 150ms;
  }
  .chip[aria-pressed="true"] {
    background: var(--info-bg);
    color: var(--info-fg);
    border-color: var(--info-fg);
  }
  .chip[data-severity="fail"][aria-pressed="true"] { background: var(--fail-bg); color: var(--fail-fg); border-color: var(--fail-fg); }
  .chip[data-severity="warn"][aria-pressed="true"] { background: var(--warn-bg); color: var(--warn-fg); border-color: var(--warn-fg); }
  .chip[data-severity="pass"][aria-pressed="true"] { background: var(--pass-bg); color: var(--pass-fg); border-color: var(--pass-fg); }
  .filter-search {
    flex: 1;
    min-width: 180px;
    padding: 0.3rem 0.6rem;
    background: var(--bg);
    color: var(--neutral-fg);
    border: 1px solid var(--border);
    border-radius: 6px;
    font: inherit;
    font-size: 13px;
  }
  /* CSS-driven filtering -- JS sets body attributes; CSS hides non-matching cards. */
  body[data-filter-severity="fail"]    section.check > details:not([data-severity="fail"]),
  body[data-filter-severity="warn"]    section.check > details:not([data-severity="warn"]),
  body[data-filter-severity="pass"]    section.check > details:not([data-severity="pass"]),
  body[data-filter-severity="skipped"] section.check > details:not([data-severity="skipped"]) { display: none; }
  body[data-filter-changed]            section.check > details:not([data-changed]) { display: none; }
  body[data-filter-search]             section.check > details:not([data-match])    { display: none; }
  /* Reduced motion. */
  @media (prefers-reduced-motion: reduce) {
    .chip, .theme-toggle { transition: none; }
    html { scroll-behavior: auto; }
  }

  /* ── Report navigation: grid shell (section rail | content column) ──
     The max-width that used to live on <body> now lives on .content-column;
     <body> becomes the full-width grid host. Below the narrow breakpoint the
     grid collapses to one column and the rail folds into a <details>. */
  html { scroll-behavior: smooth; }
  .report-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }
  .content-column { max-width: 1100px; min-width: 0; }
  @media (min-width: 64rem) {
    body { max-width: none; }
    .report-grid {
      grid-template-columns: 15rem minmax(0, 1100px);
      justify-content: center;
    }
    /* Sticky belongs on the grid ITEM (.section-rail), not the inner <nav>:
       the grid row is as tall as the content column, so the rail's sticky
       containing block spans the whole scroll; the short inner nav would let
       the rail scroll away once you pass the link list. align-self:start keeps
       the item from stretching to full row height (which would defeat sticky). */
    .section-rail {
      position: sticky;
      top: 0.5rem;
      align-self: start;
      max-height: calc(100vh - 1rem);
    }
  }

  /* Status dot -- reusable token, mapped to existing severity colors.
     Used in the section rail and the summary table. */
  .status-dot {
    display: inline-block; width: 0.6rem; height: 0.6rem;
    border-radius: 50%; flex: 0 0 auto;
    background: var(--neutral-muted);
    vertical-align: baseline;
  }
  .status-dot.pass    { background: var(--pass-fg); }
  .status-dot.warn    { background: var(--warn-fg); }
  .status-dot.fail,
  .status-dot.error   { background: var(--fail-fg); }
  .status-dot.skipped { background: var(--info-fg); }

  /* Section rail -- persistent left-column wayfinding. */
  .section-rail { font-size: 13px; }
  .section-rail .rail-inner {
    max-height: calc(100vh - 1rem);
    overflow-y: auto;
  }
  .section-rail .rail-heading {
    font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em;
    color: var(--neutral-muted); font-weight: 600;
    margin: 0 0 0.5rem 0.6rem;
  }
  .section-rail ul { list-style: none; margin: 0; padding: 0; }
  .section-rail li { margin: 0; }
  .section-rail a {
    display: flex; align-items: center; gap: 0.5rem;
    padding: 0.35rem 0.6rem; border-radius: 6px;
    color: var(--neutral-fg); text-decoration: none;
    border-left: 2px solid transparent;
    transition: background 150ms, border-color 150ms;
  }
  .section-rail a:hover { background: var(--surface); }
  .section-rail a.rail-active {
    background: var(--surface);
    border-left-color: var(--info-fg);
    font-weight: 600;
  }
  .section-rail .rail-name {
    flex: 1; min-width: 0;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .section-rail .rail-count {
    flex: 0 0 auto; font-size: 11px; font-weight: 600;
    padding: 0.05rem 0.4rem; border-radius: 999px;
    font-variant-numeric: tabular-nums;
  }
  .section-rail .rail-count.has-fail { background: var(--fail-bg); color: var(--fail-fg); }
  .section-rail .rail-count.has-warn { background: var(--warn-bg); color: var(--warn-fg); }
  /* Filter-sync: rail entries whose check has no visible cards under the
     active filter are dimmed (JS sets data-rail-dim). */
  .section-rail li[data-rail-dim] a { opacity: 0.4; }
  @media (prefers-reduced-motion: reduce) {
    .section-rail a { transition: none; }
  }
  /* Narrow-screen disclosure form: shown only below the breakpoint. The same
     <nav> is styled as a <details> wrapper there. */
  .section-rail > summary {
    cursor: pointer; font-weight: 600; padding: 0.4rem 0.6rem;
    list-style: none;
  }
  .section-rail > summary::-webkit-details-marker { display: none; }
  .section-rail > summary::before {
    content: "▸ "; color: var(--neutral-muted); font-size: 11px;
  }
  .section-rail[open] > summary::before { content: "▾ "; }
  @media (min-width: 64rem) {
    /* On wide screens the rail is always shown; neutralize <details> toggling. */
    .section-rail > summary { display: none; }
    .section-rail .rail-inner { display: block !important; }
  }

  /* Card-state left accent -- scan severity down the page without reading badges. */
  section.check > details[data-severity="fail"]  { border-left: 3px solid var(--fail-fg); padding-left: 0.6rem; }
  section.check > details[data-severity="warn"]  { border-left: 3px solid var(--warn-fg); padding-left: 0.6rem; }
  section.check > details[data-severity="error"] { border-left: 3px solid var(--fail-fg); padding-left: 0.6rem; }

  /* Hierarchy tune: inventory reads as muted context, metric grid as the
     primary scannable numbers. */
  .inventory-totals .total-value { font-size: 18px; color: var(--neutral-muted); font-weight: 600; }

  /* No-JS: the rail's anchor links still work (plain <a href="#check-N">) and
     the narrow-screen <details> is native -- only the scroll-spy highlight and
     filter-sync dimming are JS-enhanced, so the rail stays visible. */
</style>
</head>
<body>
<svg xmlns="http://www.w3.org/2000/svg" style="display:none" aria-hidden="true">
  <symbol id="icon-system" viewBox="0 0 16 16"><path fill="currentColor" d="M8 1a7 7 0 1 0 0 14A7 7 0 0 0 8 1Zm0 1.5v11A5.5 5.5 0 0 1 8 2.5Z"/></symbol>
  <symbol id="icon-light"  viewBox="0 0 16 16"><path fill="currentColor" d="M8 5a3 3 0 1 0 0 6 3 3 0 0 0 0-6Zm0-4v1.5M8 13.5V15M3.05 3.05l1.06 1.06M11.89 11.89l1.06 1.06M1 8h1.5M13.5 8H15M3.05 12.95l1.06-1.06M11.89 4.11l1.06-1.06" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" fill="none"/></symbol>
  <symbol id="icon-dark"   viewBox="0 0 16 16"><path fill="currentColor" d="M14 9.5A6 6 0 0 1 6.5 2a6 6 0 1 0 7.5 7.5Z"/></symbol>
</svg>

<div class="report-grid">
<details class="section-rail" open>
  <summary>Jump to section</summary>
  <nav class="rail-inner" aria-label="Report sections">
    <p class="rail-heading">Checks</p>
    <ul>
    {% for r in results %}
      {% set rail_fail = r.findings|selectattr('severity','equalto','fail')|list|length %}
      {% set rail_warn = r.findings|selectattr('severity','equalto','warn')|list|length %}
      <li data-rail-for="check-{{ loop.index }}">
        <a href="#check-{{ loop.index }}">
          <span class="status-dot {{ r.status }}" aria-hidden="true"></span>
          <span class="rail-name">{{ r.name }}</span>
          {% if rail_fail %}<span class="rail-count has-fail" title="{{ rail_fail }} fail">{{ rail_fail }}</span>
          {% elif rail_warn %}<span class="rail-count has-warn" title="{{ rail_warn }} warn">{{ rail_warn }}</span>{% endif %}
        </a>
      </li>
    {% endfor %}
    </ul>
  </nav>
</details>

<div class="content-column">
<h1>{{ title }}</h1>
<div class="meta">
  <span><b>Generated:</b> {{ generated_at_local }} ({{ generated_at_utc }} UTC)</span>
  <span><b>Console:</b> <span class="mono">{{ base_url_host }}</span></span>
  <span><b>Version:</b> <span class="mono">{{ tool_version }}</span></span>
  {% if content_hash %}<span><b>Run hash:</b> <span class="mono">{{ content_hash }}</span></span>{% endif %}
  <button class="theme-toggle" type="button" aria-label="Theme: system" data-theme-state="system">
    <svg class="theme-icon" width="14" height="14" aria-hidden="true"><use href="#icon-system"/></svg>
    <span class="theme-label">System</span>
  </button>
</div>

<div class="hero {{ verdict_class }}" role="status">
  <div class="verdict-word">{{ verdict_label }}</div>
  {% if metrics %}
  <div class="verdict-summary">
    {{ metrics.findings_fail }} fail · {{ metrics.findings_warn }} warn
    {% if metrics.rules_total %}across {{ metrics.rules_total }} rule{{ "" if metrics.rules_total == 1 else "s" }} in {{ results|length }} check{{ "" if results|length == 1 else "s" }}{% endif %}
  </div>
  {% endif %}
</div>

{% if inventory_totals %}
<section class="inventory-totals" aria-label="Inventory totals">
  <h2>Inventory</h2>
  <div class="totals-strip">
    <div class="total-tile"><span class="total-label">Assets</span><span class="total-value">{{ inventory_totals.total_assets }}</span></div>
    <div class="total-tile"><span class="total-label">Sites</span><span class="total-value">{{ inventory_totals.total_sites }}</span></div>
    <div class="total-tile"><span class="total-label">Scan Engines</span><span class="total-value">{{ inventory_totals.total_scan_engines }}</span></div>
    <div class="total-tile"><span class="total-label">Asset Groups (static)</span><span class="total-value">{{ inventory_totals.total_asset_groups_static }}</span></div>
    <div class="total-tile"><span class="total-label">Asset Groups (dynamic)</span><span class="total-value">{{ inventory_totals.total_asset_groups_dynamic }}</span></div>
    <div class="total-tile"><span class="total-label">Total Scans</span><span class="total-value">{{ inventory_totals.total_scans }}</span></div>
  </div>
</section>
{% endif %}

{% if delta %}
<div class="delta-strip" aria-label="Changes since last run">
  <span class="delta-pill dp-down">↓ {{ delta.resolved|length }} resolved</span>
  <span class="delta-pill dp-up">↑ {{ delta.new_fails|length }} new fails</span>
  <span class="delta-pill dp-mid">↻ {{ delta.severity_changed|length }} changed severity</span>
  <span class="since">since <span class="mono">{{ delta.prior_generated_at }}</span></span>
</div>
{% endif %}

{% if metrics %}
<div class="metric-grid" aria-label="At a glance">
  <div class="metric">
    <div class="metric-label">Rules run</div>
    <div class="metric-value">{{ metrics.rules_total }}</div>
    {% if metrics.rules_sampled %}<div class="metric-sub">{{ metrics.rules_sampled }} sampled</div>{% endif %}
  </div>
  <div class="metric">
    <div class="metric-label">Findings · fail</div>
    <div class="metric-value">{{ metrics.findings_fail }}</div>
  </div>
  <div class="metric">
    <div class="metric-label">Findings · warn</div>
    <div class="metric-value">{{ metrics.findings_warn }}</div>
  </div>
  <div class="metric">
    <div class="metric-label">Rules pass</div>
    <div class="metric-value">{{ metrics.rules_pass }}</div>
  </div>
  <div class="metric">
    <div class="metric-label">Rules · error</div>
    <div class="metric-value">{{ metrics.rules_error }}</div>
  </div>
  <div class="metric">
    <div class="metric-label">Skipped</div>
    <div class="metric-value">{{ metrics.rules_skipped }}</div>
  </div>
  <div class="metric">
    <div class="metric-label">Total duration</div>
    <div class="metric-value">{{ metrics.total_duration_ms | duration }}</div>
  </div>
</div>
{% endif %}

<h2>Summary</h2>
<table>
  <thead>
    <tr><th>Check</th><th>Status</th><th>Findings</th><th style="text-align:right">Duration</th></tr>
  </thead>
  <tbody>
  {% for r in results %}
    <tr>
      <td><a href="#check-{{ loop.index }}">{{ r.name }}</a></td>
      <td><span class="status-dot {{ r.status }}" aria-hidden="true"></span> <span class="badge {{ r.status }}">{{ r.status|upper }}</span></td>
      <td>{{ r.findings|length }} ({{ r.findings|selectattr('severity','equalto','fail')|list|length }} fail / {{ r.findings|selectattr('severity','equalto','warn')|list|length }} warn)</td>
      <td style="text-align:right">{{ r.duration_ms | duration }}</td>
    </tr>
  {% endfor %}
  </tbody>
</table>

<div class="filter-bar" role="toolbar" aria-label="Filter findings">
  <div class="filter-chips" role="group" aria-label="Filter by severity">
    <button class="chip" type="button" aria-pressed="true"  data-severity="all">All</button>
    <button class="chip" type="button" aria-pressed="false" data-severity="fail">Fail</button>
    <button class="chip" type="button" aria-pressed="false" data-severity="warn">Warn</button>
    <button class="chip" type="button" aria-pressed="false" data-severity="pass">Pass</button>
    <button class="chip" type="button" aria-pressed="false" data-severity="skipped">Skipped</button>
    {% if delta %}
    <button class="chip" type="button" aria-pressed="false" data-filter="changed">Changed</button>
    {% endif %}
  </div>
  <input class="filter-search" type="search" placeholder="Search rules…"
         aria-label="Search rules and findings">
</div>

{% for r in results %}
<section class="check" id="check-{{ loop.index }}">
  <h2>{{ r.name }} <span class="badge {{ r.status }}">{{ r.status|upper }}</span></h2>
  <p class="check-desc">{{ r.description }}</p>

  {% if r.status == "error" %}
    <div class="error-box"><b>Check failed to run:</b> {{ r.error }}</div>
  {% elif r.status == "skipped" %}
    <div class="skipped-box">This check is disabled in <code>config.yaml</code>.</div>
  {% elif not r.rule_results %}
    {# Defensive fallback: a Check that returned no rule_results renders as a
       flat findings table. Every built-in check produces rule_results since
       0.2.6, but we keep this branch so external Check implementations and
       legacy tests don't crash. #}
    {% if r.findings %}
    <table>
      <thead><tr><th>Severity</th><th>Message</th></tr></thead>
      <tbody>
      {% for f in r.findings %}
        <tr>
          <td><span class="badge {{ 'fail' if f.severity == 'fail' else 'warn' if f.severity == 'warn' else 'pass' }}">{{ f.severity|upper }}</span></td>
          <td>
            {{ f.message }}
            {% if f.details %}
              <details><summary>details</summary><pre>{{ f.details_json }}</pre></details>
            {% endif %}
          </td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% else %}
      <p>No issues found.</p>
    {% endif %}
  {% else %}
    <div class="tiles">
      <div class="tile"><b>{{ r.summary.rules_total }}</b> rules</div>
      <div class="tile"><b>{{ r.summary.rules_pass }}</b> pass</div>
      <div class="tile"><b>{{ r.summary.rules_warn }}</b> warn</div>
      <div class="tile"><b>{{ r.summary.rules_fail }}</b> fail</div>
      <div class="tile"><b>{{ r.summary.rules_error }}</b> error</div>
      <div class="tile"><b>{{ r.summary.rules_skipped }}</b> skipped</div>
    </div>

    {% for rr in r.rule_results %}
    <details id="rule-{{ rr.rule_id }}"
             data-severity="{{ rr.status }}"
             data-search-text="{{ (rr.rule_name|lower ~ ' ' ~ rr.findings|map(attribute='message')|join(' ')|lower)[:200] }}">
      <summary><b>{{ rr.rule_name }}</b> <span class="badge {{ rr.status }}">{{ rr.status|upper }}</span>{% if rr.sampled %} <span class="badge info" title="Rule ran on a sample">sampled</span>{% endif %} <span class="rule-duration">{{ rr.duration_ms | duration }}</span></summary>
      {% if rr.card_summary %}
      <div class="rule-card-summary">
        <span class="card-summary-item"><strong>{{ rr.card_summary.examined }}</strong> examined</span>
        <span class="card-summary-sep">·</span>
        <span class="card-summary-item"><strong>{{ rr.card_summary.passed }}</strong> passed</span>
        <span class="card-summary-sep">·</span>
        <span class="card-summary-item"><strong>{{ rr.card_summary.failed }}</strong> failed</span>
      </div>
      {% endif %}
      <p class="check-desc">{{ rr.description }}</p>

      {% if rr.summary %}
      <dl class="rule-summary">
        {% for k, v in rr.summary.items() %}
          <div class="rs-item"><dt>{{ k | humanize_key }}</dt><dd>{{ v | humanize_value }}</dd></div>
        {% endfor %}
      </dl>
      {% endif %}

      {% if rr.status == "error" %}
        <div class="error-box"><b>Rule failed to run:</b> {{ rr.error }}
          {% if rr.error_path %}
          <div class="rule-error-meta">
            Failed call: <code>{{ rr.error_path }}</code>{% if rr.error_status_code %} (HTTP {{ rr.error_status_code }}){% endif %}
          </div>
          {% endif %}
        </div>
      {% elif rr.status == "skipped" %}
        <div class="skipped-box">
          {% if rr.summary and rr.summary.reason %}
            {{ rr.summary.reason }}
          {% else %}
            This rule is disabled in <code>config.yaml</code>.
          {% endif %}
        </div>
      {% else %}
        {% if rr.sampled %}
          <p class="check-desc"><i>Note: {{ rr.sample_info }}</i></p>
        {% endif %}
        {% if rr.findings %}
        <table>
          <thead><tr><th>Severity</th><th>Message</th></tr></thead>
          <tbody>
          {% for f in rr.findings %}
            <tr>
              <td><span class="badge {{ 'fail' if f.severity == 'fail' else 'warn' if f.severity == 'warn' else 'pass' }}">{{ f.severity|upper }}</span></td>
              <td>
                {{ f.message }}
                {% if f.details %}
                  <details><summary>details</summary><pre>{{ f.details_json }}</pre></details>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
        {% else %}
        <p>No findings.</p>
        {% endif %}
      {% endif %}

      {% if rr.sources %}
      <p class="check-desc"><b>Sources:</b></p>
      <ul>
        {% for src in rr.sources %}
          <li><a href="{{ src }}" target="_blank" rel="noopener noreferrer">{{ src }}</a></li>
        {% endfor %}
      </ul>
      {% endif %}
    </details>
    {% endfor %}
  {% endif %}
</section>
{% endfor %}

<footer>
  <p>Config: <code>{{ config_path }}</code></p>
  {% if thresholds_table %}
  <p>Thresholds applied:</p>
  <table>
    <thead><tr><th>Setting</th><th>Value</th></tr></thead>
    <tbody>
    {% for key, value in thresholds_table %}
      <tr><td><code>{{ key }}</code></td><td>{{ value }}</td></tr>
    {% endfor %}
    </tbody>
  </table>
  {% endif %}
</footer>
</div><!-- /.content-column -->
</div><!-- /.report-grid -->

{% if state_blob_json %}
<script id="report-state" type="application/json">{{ state_blob_json | safe }}</script>
{% endif %}
{% if delta %}
<script id="report-delta" type="application/json">{{ delta | tojson | safe }}</script>
{% endif %}

<script>
(function(){
  var btn = document.querySelector('.theme-toggle');
  if (!btn) return;
  var states = [
    { name: 'system', icon: '#icon-system', label: 'System' },
    { name: 'light',  icon: '#icon-light',  label: 'Light' },
    { name: 'dark',   icon: '#icon-dark',   label: 'Dark' },
  ];
  function apply(state) {
    btn.setAttribute('data-theme-state', state.name);
    btn.setAttribute('aria-label', 'Theme: ' + state.name);
    btn.querySelector('.theme-icon use').setAttribute('href', state.icon);
    btn.querySelector('.theme-label').textContent = state.label;
    var stored = null;
    try { stored = localStorage.getItem('theme'); } catch(e) {}
    if (state.name === 'system') {
      document.documentElement.removeAttribute('data-theme');
      if (stored !== null) {
        try { localStorage.removeItem('theme'); } catch(e) {}
      }
    } else {
      document.documentElement.setAttribute('data-theme', state.name);
      if (stored !== state.name) {
        try { localStorage.setItem('theme', state.name); } catch(e) {}
      }
    }
  }
  // Restore state from <html data-theme> set by the FOUC head script.
  var initial = document.documentElement.getAttribute('data-theme');
  if (initial === 'light') apply(states[1]);
  else if (initial === 'dark') apply(states[2]);
  // (no-op if 'system' -- initial markup is already system)
  btn.addEventListener('click', function(){
    var current = btn.getAttribute('data-theme-state');
    var idx = states.findIndex(function(s){ return s.name === current; });
    apply(states[(idx + 1) % states.length]);
  });
})();
(function(){
  var bar = document.querySelector('.filter-bar');
  if (!bar) return;
  var sevChips = bar.querySelectorAll('.chip[data-severity]');
  function setSeverity(sev) {
    sevChips.forEach(function(c){
      c.setAttribute('aria-pressed', c.getAttribute('data-severity') === sev ? 'true' : 'false');
    });
    if (sev === 'all') {
      document.body.removeAttribute('data-filter-severity');
    } else {
      document.body.setAttribute('data-filter-severity', sev);
    }
    syncHash();
    if (window.__refreshRail) window.__refreshRail();
  }
  function syncHash() {
    var parts = [];
    var sev = document.body.getAttribute('data-filter-severity');
    if (sev) parts.push('severity=' + sev);
    if (document.body.hasAttribute('data-filter-changed')) parts.push('changed');
    var search = document.body.getAttribute('data-filter-search-q');
    if (search) parts.push('search=' + encodeURIComponent(search));
    var hash = parts.length ? '#' + parts.join('&') : '';
    if (location.hash !== hash) {
      history.replaceState({}, '', hash || (location.pathname + location.search));
    }
  }
  sevChips.forEach(function(c){
    c.addEventListener('click', function(){
      setSeverity(c.getAttribute('data-severity'));
    });
  });
  // Restore from hash on load.
  var hash = location.hash.replace(/^#/, '');
  if (hash) {
    var params = {};
    hash.split('&').forEach(function(p){
      var eq = p.indexOf('=');
      if (eq < 0) params[p] = true;
      else params[p.slice(0, eq)] = decodeURIComponent(p.slice(eq + 1));
    });
    if (params.severity && ['all','fail','warn','pass','skipped'].indexOf(params.severity) >= 0) {
      setSeverity(params.severity);
    }
  }
  // Expose syncHash for Tasks 5 & 6 to call after their state changes.
  window.__phase2_syncHash = syncHash;
})();
(function(){
  var input = document.querySelector('.filter-search');
  if (!input) return;
  var rules = document.querySelectorAll('section.check details[data-search-text]');
  var debounceTimer = null;
  function apply(query) {
    var q = query.trim().toLowerCase();
    if (!q) {
      document.body.removeAttribute('data-filter-search');
      document.body.removeAttribute('data-filter-search-q');
      rules.forEach(function(r){ r.removeAttribute('data-match'); });
    } else {
      document.body.setAttribute('data-filter-search', '');
      document.body.setAttribute('data-filter-search-q', q);
      rules.forEach(function(r){
        var hay = r.getAttribute('data-search-text') || '';
        if (hay.indexOf(q) >= 0) r.setAttribute('data-match', '');
        else r.removeAttribute('data-match');
      });
    }
    if (window.__phase2_syncHash) window.__phase2_syncHash();
    if (window.__refreshRail) window.__refreshRail();
  }
  input.addEventListener('input', function(){
    clearTimeout(debounceTimer);
    var v = input.value;
    debounceTimer = setTimeout(function(){ apply(v); }, 150);
  });
  // Restore from hash on load.
  var hash = location.hash.replace(/^#/, '');
  if (hash) {
    var params = {};
    hash.split('&').forEach(function(p){
      var eq = p.indexOf('=');
      if (eq < 0) params[p] = true;
      else params[p.slice(0, eq)] = decodeURIComponent(p.slice(eq + 1));
    });
    if (params.search) {
      input.value = params.search;
      apply(params.search);
    }
  }
})();
{% if delta %}
(function(){
  var chip = document.querySelector('.chip[data-filter="changed"]');
  if (!chip) return;
  var deltaEl = document.getElementById('report-delta');
  var stateEl = document.getElementById('report-state');
  if (!deltaEl || !stateEl) return;
  var delta, state;
  try {
    delta = JSON.parse(deltaEl.textContent);
    state = JSON.parse(stateEl.textContent);
  } catch(e) { return; }
  // Build signature set from delta.
  var sigs = {};
  ['resolved', 'new_fails', 'severity_changed'].forEach(function(k){
    (delta[k] || []).forEach(function(f){ if (f.signature) sigs[f.signature] = true; });
  });
  // Walk state blob, mark each rule card that has any finding signature in sigs.
  (state.results || []).forEach(function(r){
    (r.rule_results || []).forEach(function(rr){
      var match = (rr.findings || []).some(function(f){ return sigs[f.signature]; });
      if (match) {
        var card = document.getElementById('rule-' + rr.rule_id);
        if (card) card.setAttribute('data-changed', '');
      }
    });
  });
  function setChanged(active) {
    chip.setAttribute('aria-pressed', active ? 'true' : 'false');
    if (active) document.body.setAttribute('data-filter-changed', '');
    else        document.body.removeAttribute('data-filter-changed');
    if (window.__phase2_syncHash) window.__phase2_syncHash();
    if (window.__refreshRail) window.__refreshRail();
  }
  chip.addEventListener('click', function(){
    setChanged(chip.getAttribute('aria-pressed') !== 'true');
  });
  // Restore from hash.
  var hash = location.hash.replace(/^#/, '');
  if (hash.split('&').indexOf('changed') >= 0) {
    setChanged(true);
  }
})();
{% endif %}
(function(){
  function expandFromHash() {
    var hash = location.hash.replace(/^#/, '');
    if (!hash) return;
    var target = document.getElementById(hash);
    if (!target) return;
    var details = target.matches('details') ? target : target.querySelector(':scope > details');
    if (details) details.open = true;
  }
  window.addEventListener('hashchange', expandFromHash);
  expandFromHash();
})();
(function(){
  // Section rail: scroll-spy (active highlight) + filter-sync (dim entries whose
  // check has no visible cards under the active filter).
  var rail = document.querySelector('.section-rail');
  if (!rail) return;
  var links = Array.prototype.slice.call(rail.querySelectorAll('a[href^="#check-"]'));
  if (!links.length) return;
  var sections = Array.prototype.slice.call(document.querySelectorAll('section.check'));

  // Filter-sync: an entry dims when its section has details but none are visible.
  function refreshRail() {
    sections.forEach(function(sec){
      var li = rail.querySelector('li[data-rail-for="' + sec.id + '"]');
      if (!li) return;
      var cards = sec.querySelectorAll(':scope > details');
      if (!cards.length) { li.removeAttribute('data-rail-dim'); return; }
      var anyVisible = Array.prototype.some.call(cards, function(c){
        return c.offsetParent !== null; // not display:none (filtered out)
      });
      if (anyVisible) li.removeAttribute('data-rail-dim');
      else li.setAttribute('data-rail-dim', '');
    });
  }
  window.__refreshRail = refreshRail;

  // Scroll-spy via IntersectionObserver.
  if ('IntersectionObserver' in window) {
    var visible = {};
    function setActive(id) {
      links.forEach(function(a){
        a.classList.toggle('rail-active', a.getAttribute('href') === '#' + id);
      });
    }
    var obs = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting) visible[e.target.id] = true;
        else delete visible[e.target.id];
      });
      // Highlight the topmost section currently in view.
      for (var i = 0; i < sections.length; i++) {
        if (visible[sections[i].id]) { setActive(sections[i].id); break; }
      }
    }, { rootMargin: '-20% 0px -70% 0px', threshold: 0 });
    sections.forEach(function(sec){ if (sec.id) obs.observe(sec); });
  }

  refreshRail();
})();
</script>

</body>
</html>
