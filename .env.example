# Copy this to .env and fill in credentials for your InsightVM Security Console.
# See README.md "Authenticating against your console" for guidance.

# --- Security Console (v3) auth: HTTP Basic only ---
# The Console v3 API authenticates with HTTP Basic; it does NOT accept an
# X-Api-Key header (that is the v4 Insight Platform mechanism below). Use a
# dedicated read-only service account rather than personal credentials.
R7_BASIC_USER=replace-me
R7_BASIC_PASSWORD=replace-me

# Optional: Insight Platform (v4) API key, separate from the console creds.
# Required only when cloud_integration.enabled=true in config.yaml. This is the
# one place an X-Api-Key is used -- the Cloud Integrations API, not the Console.
R7_CLOUD_API_KEY=
