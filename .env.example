# Copy this to .env and fill in credentials for your InsightVM Security Console.
# See README.md "Authenticating against your console" for guidance.

# --- Option A: API key auth (default, when config.yaml has auth_mode: api_key) ---
# Generate the key in the Security Console UI itself (User -> API Keys).
# NOT the platform-wide key from insight.rapid7.com -- that's a different API.
R7_API_KEY=replace-me

# --- Option B: HTTP Basic Auth (when config.yaml has auth_mode: basic) ---
# Use this for Rapid7-hosted consoles where SAML/MFA users cannot mint a
# console-local API key. Service account preferred over personal credentials.
# R7_BASIC_USER=replace-me
# R7_BASIC_PASSWORD=replace-me

# Optional: Insight Platform API key, separate from R7_API_KEY. Required
# only when cloud_integration.enabled=true in config.yaml.
R7_CLOUD_API_KEY=
